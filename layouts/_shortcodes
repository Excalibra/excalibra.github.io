{{- $type := .Get 0 | default "note" -}}
{{- $title := .Get "title" | default "" -}}

{{- $defaults := dict
  "note" (dict "title" "Note" "icon" "circle-info" "tone" "note")
  "tip" (dict "title" "Tip" "icon" "lightbulb" "tone" "tip")
  "important" (dict "title" "Important" "icon" "comment" "tone" "important")
  "warning" (dict "title" "Warning" "icon" "triangle-exclamation" "tone" "warning")
  "caution" (dict "title" "Caution" "icon" "xmark" "tone" "caution")
-}}

{{- $meta := index $defaults $type | default (index $defaults "note") -}}
{{- $displayTitle := $title | default $meta.title -}}

<aside class="sc-callout sc-callout--{{ $meta.tone }} not-prose" role="note">
  <div class="sc-callout__content">
    <div class="sc-callout__label">
      <span class="sc-callout__icon" aria-hidden="true">{{- partial "icon.html" $meta.icon -}}</span>
      <span class="sc-callout__title">{{ $displayTitle }}</span>
    </div>
    <div class="sc-callout__body prose dark:prose-invert">
      {{ .Inner | markdownify }}
    </div>
  </div>
</aside>

